# /etc/systemd/system/vector-ru.service
# Автозапуск демона русской озвучки для Anki Vector.
# После правки: systemctl daemon-reload && systemctl restart vector-ru

[Unit]
Description=Vector Russian LLM+TTS daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/vector-ru

# ------------------- НАСТРОЙКИ -------------------
# Адрес вашей LLM (Ollama: http://IP:11434/v1/chat/completions,
# LM Studio: http://IP:1234/v1/chat/completions)
Environment=LLM_URL=http://127.0.0.1:11434/v1/chat/completions
Environment=LLM_MODEL=qwen2.5:7b
Environment=LLM_API_KEY=ollama

# Бэкенд: openai — напрямую в Ollama; homeassistant — через Assist HA
# (LLM + управление умным домом). Для HA заполните URL/TOKEN/AGENT_ID.
Environment=LLM_BACKEND=openai
Environment=HA_URL=http://192.168.0.XXX:8123
Environment=HA_TOKEN=
Environment=HA_AGENT_ID=
Environment=HA_LANGUAGE=ru

# Эмоции: LLM отвечает с тегом [радость]/[грусть]/..., робот играет анимацию
Environment=ENABLE_EMOTIONS=true


# TTS: silero (быстрый, рекомендуется на CPU) или xtts (медленный, но можно
# клонировать голос; требуется pip install coqui-tts и ~8 ГБ RAM)
Environment=TTS_ENGINE=silero
Environment=SILERO_SPEAKER=xenia
# Для XTTS: путь к WAV-образцу голоса 6-15 секунд (можно оставить пустым)
Environment=XTTS_SPEAKER_WAV=

# Слова-триггеры — те же, что в utterances кастомного интента wire-pod
Environment=TRIGGERS=вопрос,спроси,поболтаем,слушай

# Голос "под Вектора": высота тона (1.0 = как есть; 1.3 — рекомендуемый старт
# для мужских голосов aidar/eugene), темп и лёгкий "цифровой" эффект
Environment=VOICE_PITCH=1.3
Environment=VOICE_TEMPO=1.05
Environment=ROBOT_FX=true

Environment=VOLUME=80
Environment=LISTEN_PORT=8090
# --------------------------------------------------

ExecStart=/opt/vector-ru/venv/bin/python /opt/vector-ru/vector_ru_daemon.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
